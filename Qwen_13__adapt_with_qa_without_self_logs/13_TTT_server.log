rd and Image Department'}], 'lora_rank': 32, 'lora_alpha': 64, 'lora_dropout': 0.0, 'finetune_epochs': 10, 'finetune_lr': 0.001, 'batch_size': 1, 'gradient_accumulation_steps': 1, 'end_mask_substring': ''}
