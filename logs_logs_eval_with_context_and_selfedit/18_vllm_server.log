0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[151643], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=64, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [10061, 594, 4226, 264, 3405, 5961, 323, 3529, 285, 974, 624, 14582, 25, 9608, 25, 758, 18353, 448, 806, 6981, 594, 24240, 11, 35202, 36091, 304, 2329, 2906, 518, 279, 1852, 12103, 429, 1042, 714, 12226, 700, 4558, 7069, 11, 33990, 429, 2329, 15251, 26826, 13, 35202, 16105, 84045, 911, 2272, 323, 572, 14764, 311, 53541, 323, 19128, 11, 36710, 3953, 2734, 304, 77901, 11, 12375, 315, 506, 377, 5604, 11, 323, 38743, 12100, 301, 13, 1260, 572, 17247, 27061, 553, 1378, 82932, 11, 88664, 337, 316, 5918, 355, 43212, 72, 6538, 12091, 268, 323, 619, 347, 3384, 1163, 4762, 21405, 11, 879, 15599, 1435, 311, 387, 31327, 315, 1496, 279, 12196, 68022, 323, 311, 1273, 4297, 5561, 553, 3139, 13, 45869, 18651, 311, 387, 6975, 7478, 7024, 11, 10004, 43601, 911, 279, 990, 315, 2874, 714, 6857, 911, 21258, 4264, 11, 892, 311, 35202, 572, 803, 2989, 13, 26759, 1410, 537, 2990, 2953, 311, 4264, 11, 566, 6476, 11, 323, 566, 44995, 7881, 264, 2948, 2832, 349, 5025, 448, 77901, 916, 279, 15271, 594, 24654, 389, 2874, 13, 1752, 35202, 11, 2874, 1410, 387, 1483, 311, 3405, 2953, 323, 14336, 11, 714, 537, 4264, 13, 11097, 22977, 1410, 3960, 911, 4264, 1172, 1526, 29367, 38910, 11, 566, 11585, 11, 323, 53150, 8916, 6116, 14756, 2989, 311, 1435, 624, 25216, 10709, 25, 220, 16, 13, 11565, 35202, 594, 6981, 1030, 6649, 369, 1435, 311, 22729, 264, 6931, 304, 2329, 624, 17, 13, 35202, 2937, 12226, 700, 315, 2329, 2906, 624, 18, 13, 35202, 1730, 19128, 6975, 7478, 7024, 438, 432, 8900, 43601, 911, 2874, 714, 537, 911, 21258, 4264, 624, 19, 13, 35202, 7881, 264, 5025, 448, 77901, 11, 7